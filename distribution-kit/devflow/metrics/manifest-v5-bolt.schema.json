{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avenga:devflow:manifest:bolt:v5",
  "title": "Avenga DevFlow Bolt Manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bolt",
    "spec_revisions",
    "v_bounces",
    "checkpoint_approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "bolt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "ref",
        "sources",
        "generation",
        "review_ready_at",
        "review_started_at",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(US|TC)-[0-9]{3}\\.BOLT-[0-9]{3,4}$"
        },
        "type": {
          "enum": [
            "functional",
            "non-functional",
            "test"
          ]
        },
        "ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "review_ready_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "review_started_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_ready_at",
            "review_started_at"
          ],
          "properties": {
            "review_ready_at": {
              "$ref": "#/$defs/dateTimeOrNull"
            },
            "review_started_at": {
              "$ref": "#/$defs/dateTimeOrNull"
            }
          }
        }
      }
    },
    "spec_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "ref",
          "sources",
          "git_commit",
          "generation",
          "review_ready_at",
          "review_started_at"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "ref": {
            "$ref": "#/$defs/repositoryRef"
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "git_commit": {
            "$ref": "#/$defs/gitCommit"
          },
          "generation": {
            "$ref": "#/$defs/generation"
          },
          "review_ready_at": {
            "$ref": "#/$defs/dateTimeOrNull"
          },
          "review_started_at": {
            "$ref": "#/$defs/dateTimeOrNull"
          }
        }
      }
    },
    "v_bounces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "spec_revision",
          "git_commit",
          "execution_outcome",
          "code_generation",
          "mem",
          "review_ready_at",
          "review_started_at"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "spec_revision": {
            "type": "integer",
            "minimum": 1
          },
          "git_commit": {
            "$ref": "#/$defs/gitCommit"
          },
          "execution_outcome": {
            "enum": [
              "ready_for_review",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "code_generation": {
            "$ref": "#/$defs/generation"
          },
          "mem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "generation"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/repositoryRef"
              },
              "generation": {
                "$ref": "#/$defs/generation"
              }
            }
          },
          "review_ready_at": {
            "$ref": "#/$defs/dateTimeOrNull"
          },
          "review_started_at": {
            "$ref": "#/$defs/dateTimeOrNull"
          }
        }
      }
    },
    "checkpoint_approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpointApproval"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bolt": {
            "properties": {
              "type": {
                "const": "functional"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bolt": {
            "properties": {
              "id": {
                "pattern": "^US-(?!000)[0-9]{3}\\.BOLT-[0-9]{3,4}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bolt": {
            "properties": {
              "type": {
                "const": "non-functional"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bolt": {
            "properties": {
              "id": {
                "pattern": "^US-000\\.BOLT-[0-9]{3,4}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bolt": {
            "properties": {
              "type": {
                "const": "test"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bolt": {
            "properties": {
              "id": {
                "pattern": "^TC-[0-9]{3}\\.BOLT-[0-9]{3,4}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryRef"
      },
      "uniqueItems": true
    },
    "gitCommit": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 7
        },
        {
          "type": "null"
        }
      ]
    },
    "dateTimeOrNull": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_uncached",
        "input_cached_read",
        "input_cache_write",
        "output"
      ],
      "properties": {
        "input_uncached": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "input_cached_read": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "input_cache_write": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "output": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        }
      }
    },
    "nonNegativeIntegerOrNull": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "provider",
        "model",
        "tokens",
        "agent"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "agent": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "runs",
        "duration_seconds"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "pattern": "^(human|agent):.+"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "duration_seconds": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "role",
        "model"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^(human|agent):.+"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor": {
                "pattern": "^agent:"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "checkpointSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "v_bounce": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checkpointApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "subject",
        "decision",
        "decided_by",
        "decided_at"
      ],
      "properties": {
        "checkpoint": {
          "enum": [
            "AITL-US-Approval",
            "AITL-BUG-Approval",
            "AITL-TC-Approval",
            "AITL-BOLT-READY-Approval",
            "AITL-SPEC-Approval",
            "AITL-MEM-Approval",
            "AITL-BOLT-DONE-Approval"
          ]
        },
        "subject": {
          "$ref": "#/$defs/checkpointSubject"
        },
        "decision": {
          "enum": [
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decided_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approver"
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "checkpoint": {
                "enum": ["AITL-SPEC-Approval"]
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "required": [
                  "revision"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checkpoint": {
                "enum": ["AITL-MEM-Approval"]
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "required": [
                  "v_bounce"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
